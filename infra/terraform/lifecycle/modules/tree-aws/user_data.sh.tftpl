#!/bin/bash
# Wake-up script for the TREE node. Idempotent: safe on first boot and on every later wake.
set -euo pipefail
exec > >(tee -a /var/log/securax-wake.log) 2>&1

DEV="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_${volume_id_nodash}"
for i in $(seq 1 60); do [ -e "$DEV" ] && break; sleep 5; done
[ -e "$DEV" ] || { echo "roots disk never appeared"; exit 1; }

# First wake only: format. Later wakes: the disk already holds the cluster's memory — never reformat.
blkid "$DEV" >/dev/null 2>&1 || mkfs.ext4 -L securax-roots "$DEV"
mkdir -p /var/lib/rancher
grep -q securax-roots /etc/fstab || echo "LABEL=securax-roots /var/lib/rancher ext4 defaults,nofail 0 2" >> /etc/fstab
mount -a

hostnamectl set-hostname "${hostname}" || true

if [ -n "${tailscale_auth_key}" ]; then
  # Pinned static release, verified by SHA-256 BEFORE anything is installed (never a script piped into a shell).
  # To bump: change the version and both hashes together (curl -fsSL https://pkgs.tailscale.com/stable/tailscale_<ver>_<arch>.tgz.sha256).
  TS_VER="1.78.1"
  case "$(uname -m)" in
    x86_64)  TS_ARCH=amd64; TS_SHA=3db491bd6800012173cb6b739fa6705272f71da3e622f23639a3a385f2474a89 ;;
    aarch64) TS_ARCH=arm64; TS_SHA=8eb0ae11ac2f80beac379722b37651e6ef328d098fec0425ca2786c1c8f087e3 ;;
    *) echo "unsupported CPU for the pinned tailscale build: $(uname -m)"; exit 1 ;;
  esac
  TS_TMP="$(mktemp -d)"
  curl -fsSL "https://pkgs.tailscale.com/stable/tailscale_$${TS_VER}_$${TS_ARCH}.tgz" -o "$TS_TMP/ts.tgz"
  echo "$TS_SHA  $TS_TMP/ts.tgz" | sha256sum -c - >/dev/null || { echo "tailscale tarball does not match its pinned hash: refusing to install"; exit 1; }
  tar -xzf "$TS_TMP/ts.tgz" -C "$TS_TMP" --strip-components=1
  install -m 0755 "$TS_TMP/tailscale" /usr/bin/tailscale
  install -m 0755 "$TS_TMP/tailscaled" /usr/sbin/tailscaled
  install -m 0644 "$TS_TMP/systemd/tailscaled.service" /etc/systemd/system/tailscaled.service
  install -D -m 0644 "$TS_TMP/systemd/tailscaled.defaults" /etc/default/tailscaled
  rm -rf "$TS_TMP"
  systemctl daemon-reload
  systemctl enable --now tailscaled
  tailscale up --auth-key="${tailscale_auth_key}" --hostname="${hostname}" --ssh
fi

if ! command -v k3s >/dev/null 2>&1; then
  # Installer pinned by hash and run from a file: checked BEFORE it runs, never piped into a shell.
  # (The script then verifies the k3s binary against the release checksums.) Re-pin with k3s_version bumps.
  K3S_INSTALLER="$(mktemp)"
  curl -fsSL "${k3s_installer_url}" -o "$K3S_INSTALLER"
  echo "${k3s_installer_sha256}  $K3S_INSTALLER" | sha256sum -c - >/dev/null || { echo "k3s installer does not match its pinned hash: refusing to run it"; exit 1; }
  INSTALL_K3S_VERSION="${k3s_version}" sh "$K3S_INSTALLER" server --write-kubeconfig-mode 600 --secrets-encryption
  rm -f "$K3S_INSTALLER"
fi
systemctl enable --now k3s

# Germinate the rest from the genome: Argo CD pulls everything else from git (gitops/bootstrap), keeps it in sync,
# and undoes drift. On a later wake this is a no-op because the cluster state is on the roots disk.
export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
for i in $(seq 1 60); do k3s kubectl get nodes >/dev/null 2>&1 && break; sleep 5; done
k3s kubectl create namespace argocd --dry-run=client -o yaml | k3s kubectl apply -f -
k3s kubectl apply --server-side -n argocd -f "https://raw.githubusercontent.com/argoproj/argo-cd/${argocd_version}/manifests/install.yaml"
cat <<'EOF' | k3s kubectl apply -f -
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: securax-root
  namespace: argocd
spec:
  project: default
  source:
    repoURL: ${gitops_repo}
    targetRevision: ${gitops_ref}
    path: gitops/bootstrap
  destination:
    server: https://kubernetes.default.svc
    namespace: argocd
  syncPolicy:
    automated: { prune: true, selfHeal: true }
EOF
