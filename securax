      _i=0; while [ "$_i" -lt 40 ] && ! web_up "$_n" "$_pt"; do sleep 4; _i=$((_i+1)); done
      if web_up "$_n" "$_pt"; then C "$_n is running: $(web_url "$_n" "$_pt" /)"
        if [ "$_n" = pass ]; then                                    # an if, not `[ ] &&`: a false test as the last command made start exit 1
          skv "$ENVF" PASSWORDS_ENABLED 1; C "  1. Open it and create YOUR account (one only). 2. Close sign-ups:  ./securax passwords lock"
          C "  3. Install the Bitwarden app or browser extension, and set its server to $(web_url pass 8222 "")"; fi
      else C "$_n is still starting (large first start). Reload the Command Center in a minute; if it stays grey run  ./securax doctor"; fi
    done
    ;;
  stop)
    # ./securax stop docs|flows|all — stop Private Docs / Automation and forget them (they stay off after the next `up`).
    case "${2:-}" in docs) _svc="anythingllm"; _tok="docs" ;; flows|n8n) _svc="n8n"; _tok="flows" ;; passwords) _svc="vaultwarden"; _tok="passwords" ;;
      all) _svc="anythingllm n8n"; _tok="docs flows" ;;
      *) C "usage: ./securax stop docs | flows | passwords | all   (to stop everything: ./securax down)"; exit 2 ;; esac
    ( cd "$ROOT/local/compose" && docker compose --profile ai stop $_svc $(for _s in $_svc; do echo "${_s}-tls"; done) 2>/dev/null ) || true
    ENVF="$ROOT/local/compose/.env"; _cur=" $(ev SECURAX_OPTIONAL) "; for _t in $_tok; do _cur="${_cur// $_t / }"; done
    skv "$ENVF" SECURAX_OPTIONAL "$(echo $_cur)"; C "stopped: $_tok"
    ;;
  down)  ( cd "$ROOT/local/compose" && docker compose --profile ai down ) ; C "stopped." ;;
