    else C "✔ Backup saved & verified: $OUTF ($(du -h "$OUTF" | cut -f1)) — contains your API keys, NOT encrypted; keep it private. To encrypt:  ./securax crypto keygen ~/securax-backup.key"; fi
    ;;
  restore)
    # ./securax restore FILE [--yes] — replaces current data with the backup (current .env is kept as .env.pre-restore).
    F="${2:-}"; [ -f "$F" ] || { echo "usage: ./securax restore <backup.tar.gz[.gpg]> [--yes] [--keyfile PATH]   (see ./backups)"; exit 1; }
    YES=0; RKEY=""; _prev=""; for _a in "${@:3}"; do { [ "$_a" = "--yes" ] && YES=1; }; [ "$_prev" = "--keyfile" ] && RKEY="$_a"; _prev="$_a"; done
    PTMP="$(mktemp -d)"; trap 'rm -rf "$PTMP" "${STG:-}"; gpg_cleanup' EXIT
    case "$F" in *.gpg)
      gpg_prepare && backup_key "$PTMP" open "$RKEY" || exit 1
      gpg_run $GPGSYM --passphrase-file "$BKEY" -d -o "$PTMP/plain.tar.gz" "$F" >/dev/null 2>&1 \
        || { C "Could not decrypt: wrong key file / passphrase, or the file was altered. Nothing was changed."; exit 1; }
      F="$PTMP/plain.tar.gz" ;; esac
    tar tzf "$F" >/dev/null 2>&1 || { C "That file isn't a valid SecuRAX backup (unreadable archive)."; exit 1; }
