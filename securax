    "$0" backup || { C "The backup did not finish. Encryption is switched on: run  ./securax backup  again once it is fixed (./securax doctor helps)."; exit 1; }
    DEST="$(ev SECURAX_BACKUP_DIR "$ROOT/backups")"; NEWEST="$(python3 "$ROOT/governance/ransomguard.py" pick "$DEST" --encrypted 2>/dev/null || true)"
    [ -n "$NEWEST" ] || { C "No encrypted backup was found. Run  ./securax doctor"; exit 1; }
    if gpg_run $GPGSYM --passphrase-file "$KEY" -d "$NEWEST" 2>/dev/null | tar tzf - >/dev/null; then
      C "✔ Done. Backups are encrypted from now on (also the automatic one before every update)."
      echo "  Proof: your newest backup opens with your key: $NEWEST"
    else C "The new backup did NOT open with your key - do not rely on it. Run  ./securax doctor  and tell me what it says."; exit 1; fi
    echo "  Old plain backups in $DEST can still be read by anyone who has them: delete them when you no longer need them."
    ;;
