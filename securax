    C "Restarting…"; exec "$0" up
    ;;
  watch)
    # Watchdog: checks READY every WATCH_INTERVAL s (default 60); if down, heals with `up` (at most once per 5 min)
    # and tells you (log + optional ALERT_WEBHOOK in .env — e.g. an ntfy.sh topic URL; only a short status line is sent).
    #   ./securax watch          run forever (Ctrl+C to stop)       ./securax watch --once   check once, heal if needed
    LOG="$ROOT/watch.log"; ST=ok; LASTHEAL=0; WH="$(ev ALERT_WEBHOOK)"
    note(){ printf '%s %s\n' "$(date '+%F %T')" "$*" | tee -a "$LOG"; [ -n "$WH" ] && curl -fsS -m 10 -X POST -d "SecuRAX: $*" "$WH" >/dev/null 2>&1 || true; }
    while :; do
      if gcurl -fsS -m 5 $(gw_url)/readyz >/dev/null 2>&1; then
        [ "$ST" = ok ] || note "recovered — estate is READY again"; ST=ok
      else
        if [ "$ST" = ok ]; then note "NOT READY — healing with ./securax up"; ST=down; fi
        NOW="$(date +%s)"
        if [ $(( NOW - LASTHEAL )) -ge 300 ]; then
          LASTHEAL="$NOW"; SECURAX_NO_OPEN=1 "$0" up >>"$LOG" 2>&1 || note "heal attempt failed — run ./securax doctor"
          if gcurl -fsS -m 5 $(gw_url)/readyz >/dev/null 2>&1; then note "recovered — estate is READY again"; ST=ok; fi
        fi
      fi
      [ "${2:-}" = "--once" ] && break
      sleep "$(ev WATCH_INTERVAL 60)"
    done
    ;;
  update)
    # ONE command to get current — SAFELY: back up, pull the latest code, recreate the containers, check the estate really starts, and if it does
    # not, go back to the version that worked (your data is never touched by the code update; the backup is printed so you can always restore).
    # (A plain `git pull` only changes files on disk — running containers keep the OLD code.)
    git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1 || { C "This isn't a git checkout — download the latest ZIP instead."; exit 1; }
    C "Updating SecuRAX safely (backup → update → health check → automatic rollback if needed)…"
    # Legacy: older versions rewrote the tracked baseline on every `up`; restore it so the pull can't conflict.
    git -C "$ROOT" diff --quiet -- local/compose/litellm-config.yaml 2>/dev/null || git -C "$ROOT" checkout -- local/compose/litellm-config.yaml
    PREV="$(git -C "$ROOT" rev-parse HEAD)"
    CLEAN=0; [ -z "$(git -C "$ROOT" status --porcelain --untracked-files=no 2>/dev/null)" ] && CLEAN=1
    # 1) a safety copy, only when there is a running estate with data (never blocks the update)
    _alive=0; for _i in 1 2 3; do gcurl -fsS -m 10 $(gw_url)/healthz >/dev/null 2>&1 && { _alive=1; break; }; sleep 2; done
    [ "$_alive" = 1 ] || C "  (no running estate answered its health check — skipping the safety backup; run ./securax backup yourself first if the estate holds data)"
    if [ "$_alive" = 1 ]; then
      if SAFE_OUT="$("$0" backup 2>&1)"; then C "  ✔ backup taken first: $(printf '%s' "$SAFE_OUT" | tail -1)"; else C "  (could not take a backup — continuing; your data volumes are not touched by an update). Reason: $(printf '%s' "$SAFE_OUT" | tail -c 300)"; fi
    fi
    git -C "$ROOT" pull --ff-only || { C "git pull failed — you may have local changes. See:  git -C \"$ROOT\" status"; exit 1; }
    NEW="$(git -C "$ROOT" rev-parse HEAD)"
    "$0" down || true
    if SECURAX_NO_OPEN=1 "$0" up && gcurl -fsS -m 10 $(gw_url)/readyz >/dev/null 2>&1; then
      [ "$PREV" = "$NEW" ] && C "Already on the latest version — containers recreated." || C "✔ Updated to $(git -C "$ROOT" rev-parse --short HEAD) and the estate is READY."
      "$0" open >/dev/null 2>&1 || true
      exit 0
    fi
    # 2) the new version did not come up healthy: go back to the one that did
    if [ "$PREV" != "$NEW" ] && [ "$CLEAN" = 1 ]; then
      C "⚠ The new version did not start healthy. Rolling back to $(git -C "$ROOT" rev-parse --short "$PREV") (your data is untouched)…"
      git -C "$ROOT" reset --hard "$PREV" >/dev/null 2>&1
      "$0" down || true
      if SECURAX_NO_OPEN=1 "$0" up && gcurl -fsS -m 10 $(gw_url)/readyz >/dev/null 2>&1; then
        C "✔ Rolled back: the previous version is running again. Please report the failed update (it was $(git -C "$ROOT" rev-parse --short "$NEW"))."
        "$0" open >/dev/null 2>&1 || true
        exit 3
      fi
      C "✗ The previous version did not start either — run  ./securax doctor ; your data and backup are intact."
      exit 1
    fi
