    command -v docker >/dev/null 2>&1 || { C "Docker is not available here. Start Docker Desktop, wait for the whale icon to settle, then run this again."; C "  On Windows: Docker Desktop → Settings → Resources → WSL integration → turn on Ubuntu → Apply & restart, then in PowerShell  wsl --shutdown  and reopen Ubuntu."; exit 1; }
