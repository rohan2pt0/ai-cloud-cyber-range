    OUTD="${2:-$ROOT/evidence}"; mkdir -p "$OUTD"; TS="$(date +%Y%m%d-%H%M%S)"; RAW="$(mktemp -d)"; trap 'rm -rf "$RAW"' EXIT
    git -C "$ROOT" rev-parse --short HEAD > "$RAW/git_commit" 2>/dev/null || true
    docker --version > "$RAW/docker_version" 2>/dev/null || true
    gcurl -fsS -m 3 $(gw_url)/readyz > "$RAW/readyz" 2>/dev/null && echo " READY" >> "$RAW/readyz" || echo "NOT READY" > "$RAW/readyz"
    gcurl -fsS -m 3 $(gw_url)/version > "$RAW/gateway_version" 2>/dev/null || true
    ( cd "$ROOT/local/compose" && docker compose --profile ai ps --format '{{.Service}} {{.Image}} {{.Status}}' > "$RAW/compose_ps" 2>/dev/null; \
