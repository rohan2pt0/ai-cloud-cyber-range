    # strong: DeepSeek V4 Pro / Kimi K3 / GLM 5.3 -> ... -> local) as the rest of the estate. Docs: docs 42 and 83.
    if ! command -v opencode >/dev/null 2>&1; then
      C "OpenCode (the terminal UI) is not installed. Install it once - a pinned version, from npm, NOT a curl-to-shell script:"
      echo "   npm install -g opencode-ai@1.19.0        # MIT licence; needs Node.js (Ubuntu/WSL:  sudo apt install nodejs npm)"
      echo "Then run  ./securax opencode  again. (Upgrade on purpose later; auto-update is switched off in the config we write.)"
      exit 1
    fi
    gcurl -fsS $(gw_url)/healthz >/dev/null 2>&1 || { C "The gateway is down - run  ./securax up  first."; exit 1; }
    ENVF="$ROOT/local/compose/.env"; OCD="${SECURAX_HOME_DIR:-$HOME/.securax}/opencode"; REAARG=""; STRONGARG=""
    if [ "${2:-}" = "--strong" ]; then     # the hard work (./securax route says "strong"): start on the strongest open models (doc 83)
      STRONGARG="--strong"; set -- "$1" "${@:3}"; C "Starting on the strong chain (the strongest open models). The build ladder is one pick away in /models."
    fi
    if [ "${2:-}" = "--rea" ]; then
      docker image inspect securax-rea:6.5.0 >/dev/null 2>&1 || { C "The REA sandbox image is not built yet:  ./securax inspect --build   (once; needs Docker and internet)"; exit 1; }
      REAARG="--rea-project $PWD"; set -- "$1" "${@:3}"; C "REA (reverse engineering) is available to the agent, inside its sandbox: no network, read-only disk, this folder mounted read-only."
    fi
    python3 "$ROOT/local/compose/gen_opencode_config.py" --env-file "$ENVF" --base-url "$(gw_url)" $REAARG $STRONGARG --out "$OCD/opencode.json" >/dev/null || { C "Could not write the OpenCode config."; exit 1; }
    chmod 700 "$OCD" 2>/dev/null || true
    export OPENCODE_CONFIG="$OCD/opencode.json" SECURAX_GATEWAY_KEY="$(ev WEBUI_GATEWAY_KEY "$(ev LITELLM_MASTER_KEY sk-range-dev)")"
    internal_on && export NODE_EXTRA_CA_CERTS="$(tls_home)/ca.crt"
    C "OpenCode -> SecuRAX gateway. It can only reach the gateway; it asks before editing files or running commands; sharing and auto-update are off."
    shift; exec opencode "$@"
    ;;
  protect)
    # ONE guided step that protects your backups: makes a key, helps you save a second copy, switches encryption on, takes the first
    # encrypted backup and proves it opens. Flags for scripts: --yes (no questions) --copy-to DIR --key PATH.
    ENVF="$ROOT/local/compose/.env"; [ -f "$ENVF" ] || cp "$ROOT/local/compose/.env.example" "$ENVF"
    YES=0; COPYTO=""; PKEY=""; _prev=""
    for _a in "${@:2}"; do [ "$_a" = "--yes" ] && YES=1; [ "$_prev" = "--copy-to" ] && COPYTO="$_a"; [ "$_prev" = "--key" ] && PKEY="$_a"; _prev="$_a"; done
    KEY="${PKEY:-$(ev SECURAX_BACKUP_KEYFILE)}"; KEY="${KEY:-$HOME/securax-backup.key}"; KEY="${KEY/#\~/$HOME}"
    gpg_prepare || exit 1; trap 'gpg_cleanup' EXIT
    C "Protecting your backups. I make a secret key file, you keep a copy somewhere safe, and every backup is locked with it."
    echo "  If the key is lost, nobody can open the backups - so the safe copy matters more than anything else here."
    if [ -s "$KEY" ]; then echo "  Using your existing key: $KEY"; else python3 "$ROOT/governance/crypto.py" keygen "$KEY" --quiet || exit 1; echo "  ✔ Made your key: $KEY"; fi
    if [ -z "$COPYTO" ] && [ "$YES" != 1 ] && [ -r /dev/tty ]; then
      echo; echo "  Where should I save a SECOND copy of the key?"
      echo "    - a USB stick: plug it in, then type its drive letter (drives found here: $(ls -d /mnt/[d-z] 2>/dev/null | sed 's#/mnt/##' | tr '\n' ' ')  )"
      echo "    - or just press Enter: I will show you the key to save in your password manager instead."
      printf '  Drive letter (for example D) or Enter: '; read -r DL < /dev/tty || DL=""
      [ -n "$DL" ] && COPYTO="/mnt/$(printf '%s' "$DL" | tr 'A-Z' 'a-z' | tr -d ':\\/ ')"
    fi
    SAVED=0
    if [ -n "$COPYTO" ]; then
      if [ -d "$COPYTO" ] && cp "$KEY" "$COPYTO/securax-backup.key" 2>/dev/null && cmp -s "$KEY" "$COPYTO/securax-backup.key"; then
        echo "  ✔ Saved a second copy: $COPYTO/securax-backup.key  (take the stick out and keep it somewhere safe)"; SAVED=1
      else C "  ✗ I could not write to $COPYTO (is it plugged in?). Nothing is switched on yet; run  ./securax protect  again."; exit 1; fi
    elif [ "$YES" != 1 ] && [ -r /dev/tty ]; then
      echo; echo "  Save this in your password manager as a secure note called  SecuRAX backup key :"; echo; echo "      $(head -1 "$KEY")"; echo
      printf '  Type YES once it is saved: '; read -r OKS < /dev/tty || OKS=""
      [ "$OKS" = "YES" ] || { C "  Not switching encryption on yet (only the key file exists). Run  ./securax protect  again when you are ready."; exit 1; }; SAVED=1
    fi
    [ "$SAVED" = 1 ] || echo "  (no second copy was made - the only copy is $KEY: copy it somewhere safe yourself)"
