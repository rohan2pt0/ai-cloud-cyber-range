    tar xzf "$F" -C "$STG" || { C "Could not unpack the backup."; exit 1; }
    ( cd "$STG" && sha256sum -c SHA256SUMS >/dev/null 2>&1 ) || { C "Backup checksum mismatch — file is damaged. Nothing was changed."; exit 1; }
    IMG="vulnbank/llm-gateway:dev"; docker image inspect "$IMG" >/dev/null 2>&1 || IMG="alpine"
    "$0" down >/dev/null 2>&1 || true
    for T in "$STG"/vol-*.tgz; do
      [ -f "$T" ] || continue; V="$(basename "$T" .tgz)"; V="${V#vol-}"
      docker volume create "$V" >/dev/null
      docker run --rm --user 0 --entrypoint sh -v "$V":/v -v "$STG":/in "$IMG" -c "find /v -mindepth 1 -delete; tar xzf /in/vol-$V.tgz -C /v" \
        || { C "Restore of $V failed — run ./securax restore again (data volumes may be partly restored)."; exit 1; }
      echo "  ✔ restored $V"
    done
