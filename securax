    C "Updating SecuRAX (git pull, then recreate the containers)…"
    # Legacy: older versions rewrote the tracked baseline on every `up`; restore it so the pull can't conflict.
    git -C "$ROOT" diff --quiet -- local/compose/litellm-config.yaml 2>/dev/null || git -C "$ROOT" checkout -- local/compose/litellm-config.yaml
    git -C "$ROOT" pull --ff-only || { C "git pull failed — you may have local changes. See:  git -C \"$ROOT\" status"; exit 1; }
    "$0" down && exec "$0" up
    ;;
  pull)
    # Pull the sovereign local model in the FOREGROUND (so you can be sure it's ready, unlike the
    # background pull `up` kicks off). This is the free/offline model Chat uses as 'bank-assistant-local'.
    LM="${2:-$(ev LOCAL_MODEL qwen2.5:1.5b)}"
    CID="$(cd "$ROOT/local/compose" && docker compose ps -q ollama 2>/dev/null || true)"
    [ -z "$CID" ] && { C "ollama isn't running — start the estate first with  ./securax up"; exit 1; }
    C "Pulling local model '$LM' (first time can take a few minutes)…"
    if docker exec "$CID" ollama pull "$LM"; then
      C "Done ✔  In Chat (http://localhost:3000) pick 'bank-assistant-local' — free, sovereign, no key."
    else
      C "Pull failed — check your internet, or run  ./securax doctor  to see the real error."
    fi
    ;;
  size)      ENVF="$ROOT/local/compose/.env"; [ -f "$ENVF" ] || cp "$ROOT/local/compose/.env.example" "$ENVF"; autosize ;;
  preflight) preflight && C "preflight: no blockers found." ;;
  models)
    # Ask each provider which models your key can use TODAY and fix any retired name in .env (self-correcting).
    #   ./securax models          report        ./securax models --fix   report + repair + reload the router
    ENVF="$ROOT/local/compose/.env"; [ -f "$ENVF" ] || cp "$ROOT/local/compose/.env.example" "$ENVF"
    command -v python3 >/dev/null 2>&1 || { C "python3 is needed for this check."; exit 1; }
    C "Checking your providers' live model lists…"
    if [ "${2:-}" = "--fix" ]; then
      OUTM="$(python3 "$ROOT/local/compose/model_discovery.py" --env-file "$ENVF" --write)"; echo "$OUTM"
      if printf '%s' "$OUTM" | grep -q "updated"; then
        python3 "$ROOT/local/compose/gen_litellm_config.py" --write --env-file "$ENVF" >/dev/null
        if curl -fsS -m 3 http://localhost:8080/healthz >/dev/null 2>&1; then
          ( cd "$ROOT/local/compose" && docker compose --profile ai restart litellm gateway >/dev/null 2>&1 || true ); ready_wait 150 || true
        fi
      fi
    else
      python3 "$ROOT/local/compose/model_discovery.py" --env-file "$ENVF"
    fi
    ;;
  stages|soil|grow|hibernate|prune|scale|rhythm|tenant|organ|organ-check|burrow|spore|range)
    # The lifecycle engine: grow the estate from the dormant seed up to a multi-tenant forest, and put it back to sleep.
    #   ./securax stages            what is awake / hibernating / dormant     ./securax soil <stage>   preflight
    #   ./securax grow sprout [--with wazuh,misp,thehive]    ./securax hibernate sprout    (data is kept)
    #   ./securax grow tree|canopy|forest [--apply]           cloud: plans only unless --apply
    command -v python3 >/dev/null 2>&1 || { C "python3 is needed for the lifecycle commands."; exit 1; }
    exec python3 "$ROOT/lifecycle/lifecycle.py" "$@"
    ;;
  keys)
    # Guided key setup: the three FREE providers, in the order that gives the fastest answers, then a LIVE TEST
    # that shows which provider actually answered and how long it took. Enter skips any step.
    ENVF="$ROOT/local/compose/.env"; [ -f "$ENVF" ] || cp "$ROOT/local/compose/.env.example" "$ENVF"
    C "Free API keys — each takes ~1 minute. Press Enter at any key prompt to skip that one."
    echo "  Order matters: the router tries them top-down, then falls back to your private local model."
    for P in gemini groq openrouter; do
      printf '\n▶ Set up %s now? [Y/n]: ' "$P"; read -r YN < /dev/tty || YN="n"
      case "$YN" in [Nn]*) continue;; esac
      SECURAX_NOAPPLY=1 "$0" providers add "$P" || true
    done
    C "Verifying each key and model against the provider (retired model names are fixed automatically)…"
    python3 "$ROOT/local/compose/model_discovery.py" --env-file "$ENVF" --write || true
    python3 "$ROOT/local/compose/gen_litellm_config.py" --write --env-file "$ENVF" >/dev/null
    if curl -fsS -m 3 http://localhost:8080/healthz >/dev/null 2>&1; then
      C "Applying (reloading the router + gateway)…"
      ( cd "$ROOT/local/compose" && docker compose --profile ai up -d litellm gateway >/dev/null 2>&1 || true
        docker compose --profile ai restart litellm gateway >/dev/null 2>&1 || true )
      ready_wait 150 || C "  (router still starting — try  ./securax doctor  in a minute)"
      C "Live test — asking the router through the security gateway…"
      T0=$(date +%s)
      R="$(curl -sS -m 120 http://localhost:8080/v1/chat/completions -H 'Content-Type: application/json' \
           -d '{"model":"bank-assistant","messages":[{"role":"user","content":"Reply with the single word OK."}]}' 2>&1 || true)"
      echo "  reply (${T0:+$(( $(date +%s) - T0 ))s}): $(printf '%s' "$R" | python3 -c 'import sys,json
try: print(json.load(sys.stdin)["choices"][0]["message"]["content"][:80])
except Exception: print("NO ANSWER -> run ./securax doctor")' 2>/dev/null)"
    else
      C "Keys saved. Start the estate with  ./securax up  — it will use them automatically."
    fi
    ;;
  providers)
    # Plugin-style AI provider management. `list` shows status; `add` pastes a key, regenerates the
    # router config from plugins/catalog.json, and restarts the router so the model appears in Chat.
    sub="${2:-list}"
    GEN="$ROOT/local/compose/gen_litellm_config.py"
    ENVF="$ROOT/local/compose/.env"
    [ -f "$ENVF" ] || cp "$ROOT/local/compose/.env.example" "$ENVF"
    case "$sub" in
      list|status)
        C "AI provider plugins  (ON = key set).  Add one with:  ./securax providers add"
        python3 "$GEN" --status --env-file "$ENVF" ;;
      add)
        C "Add an AI provider plugin. Current status:"
        python3 "$GEN" --status --env-file "$ENVF"
        PID="${3:-}"
        if [ -z "$PID" ]; then
          printf '\nProvider id to enable (openai, anthropic, deepseek, mistral, grok, perplexity, azure, bedrock, openrouter, elevenlabs): '
          read -r PID < /dev/tty || PID=""
        fi
        PID="$(printf '%s' "$PID" | tr 'A-Z' 'a-z' | tr -d '[:space:]')"
        [ -z "$PID" ] && { C "nothing to do."; exit 0; }
        case "$PID" in */*|.*|*securax*) C "That looks like a command, not a provider id. Type just the id (e.g. groq), or Ctrl+C and run it in a new line."; exit 1;; esac
        INFO="$(python3 -c 'import json,sys
cat=json.load(open(sys.argv[1])); p=next((x for x in cat["providers"] if x["id"]==sys.argv[2]),None)
if not p: sys.exit(3)
print(" ".join(p.get("env",[]))); print(p.get("get_key","")); print(p.get("note",""))' "$ROOT/plugins/catalog.json" "$PID")" || { C "unknown provider id: $PID — valid ids:"; python3 "$GEN" --status --env-file "$ENVF" | sed 's/^  \[...\] /    /' | awk '{print "   ",$1}' | grep -v chain | tr '\n' ' '; echo; exit 1; }
        KEYS="$(printf '%s\n' "$INFO" | sed -n 1p)"; GETURL="$(printf '%s\n' "$INFO" | sed -n 2p)"; NOTE="$(printf '%s\n' "$INFO" | sed -n 3p)"
        [ -n "$GETURL" ] && C "  Get a key: $GETURL"
        [ -n "$NOTE" ]   && echo "  note: $NOTE"
        FIRST=1
        for K in $KEYS; do
          # Typed silently (not echoed): a visible key ends up in screenshots and chat pastes.
          printf '  %s (input hidden — paste, then press Enter) = ' "$K"; read -rs V < /dev/tty || V=""; echo
          [ -z "$V" ] && { echo "    (skipped $K)"; FIRST=0; continue; }
          if [ "$FIRST" = 1 ]; then
            CK="$(printf '%s' "$V" | python3 "$GEN" --check-key "$PID" 2>/dev/null || echo ok)"
            case "$CK" in
              other:*) OTH="${CK#other:}"; C "  ⚠ That looks like an '${OTH%%:*}' key, not a '$PID' key."
                       printf '    Save it as %s anyway? [y/N]: ' "$K"; read -r YN < /dev/tty || YN="n"
                       case "$YN" in [Yy]*) ;; *) echo "    not saved — run ./securax providers add again and choose '${OTH%%:*}'."; FIRST=0; continue;; esac ;;
              prefix:*) echo "    note: $PID keys usually start with '${CK#prefix:}' — double-check this is the right key." ;;
            esac
          fi
          FIRST=0
          skv "$ENVF" "$K" "$V" && echo "    ✔ saved $K (${#V} chars, starts '${V:0:5}…')"
        done
        python3 "$GEN" --write --env-file "$ENVF" >/dev/null && C "  ✔ router config regenerated from the plugin catalog."
        [ "${SECURAX_NOAPPLY:-0}" = 1 ] && exit 0      # caller (./securax keys) applies once at the end
        C "Applying (reloading the router + gateway so the new model is picked up)…"
        # `up -d` starts them if down; `restart` forces a reload of the bind-mounted config if they
        # were already running (a bind-mount change alone does NOT trigger a recreate).
        ( cd "$ROOT/local/compose" && docker compose --profile ai up -d litellm gateway >/dev/null 2>&1 || true
          docker compose --profile ai restart litellm gateway >/dev/null 2>&1 || true )
        ready_wait 150 || C "  (the router is still starting — give it a minute)"
        C "Done. Open Chat (http://localhost:3000) and pick the new model from the dropdown." ;;
      *) echo 'usage: ./securax providers [list|add]'; exit 1 ;;
    esac
    ;;
  say)
    # ElevenLabs text-to-speech (voice plugin). NOTE: text is sent to ElevenLabs' API (not sovereign).
    shift; TXT="$*"
    [ -z "$TXT" ] && { echo 'usage: ./securax say "text to speak"'; exit 1; }
    ENVF="$ROOT/local/compose/.env"
    KEY="$(sed -n 's/^ELEVENLABS_API_KEY=//p' "$ENVF" 2>/dev/null | head -1)"
    [ -z "$KEY" ] && { C "No ElevenLabs key set. Add one with:  ./securax providers add   (provider: elevenlabs)"; exit 1; }
    VOICE="$(sed -n 's/^ELEVENLABS_VOICE_ID=//p' "$ENVF" 2>/dev/null | head -1)"; VOICE="${VOICE:-21m00Tcm4TlvDq8ikWAM}"
    OUT="${SECURAX_SAY_OUT:-$ROOT/securax-speech.mp3}"
    BODY="$(python3 -c 'import json,sys;print(json.dumps({"text":sys.argv[1],"model_id":"eleven_multilingual_v2"}))' "$TXT")"
    if curl -fsS -X POST "https://api.elevenlabs.io/v1/text-to-speech/$VOICE" \
         -H "xi-api-key: $KEY" -H "Content-Type: application/json" -d "$BODY" -o "$OUT"; then
      C "Saved speech to $OUT  (play it with any audio player)."
    else C "ElevenLabs request failed — check the key, the voice id, or your network."; fi
    ;;
  version|--version|-v)
    v="$(cat "$ROOT/VERSION" 2>/dev/null || echo 0.0.0-dev)"
    g="$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || echo unknown)"
    echo "SecuRAX v${v} (${g})"
    ;;
  mcp)   exec python3 "$ROOT/mcp/securax_mcp.py" ;;
  down)  ( cd "$ROOT/local/compose" && docker compose --profile ai down ) ; C "stopped." ;;
  *) echo 'usage: ./securax [setup|up|status|version|open|doctor|update|guard [status|on|off]|profile|pull|build "task"|escalate "task"|providers [list|add]|say "text"|demo|learn|intel|plan|advisors|ask <agent> "q"|enhance "q"|research "task" --allow d.com [--render]|act action.json --allow d.com --approve|design "prompt"|routines [list|due|run]|mcp|full up|full down|down]'; exit 1 ;;
esac
