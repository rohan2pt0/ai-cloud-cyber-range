      # GNU tar exits 1 (not 2) when a file was written while it was read: on a RUNNING estate (Open WebUI 0.12 writes its data
      # folder constantly) that is normal; the archive is complete and is verified below, so it counts as a good copy.
      if [ "$RC" = 1 ] && printf '%s' "$VOUT" | grep -q "file changed as we read it" && tar tzf "$STG/vol-$V.tgz" >/dev/null 2>&1; then RC=0; fi
      if [ "$RC" = 0 ]; then
        echo "volume $V" >> "$STG/MANIFEST"
      else
        C "Could not read volume $V — aborting (no partial backup written). Reason: $(printf '%s' "$VOUT" | tail -c 400)"; exit 1
      fi
