    SPD="${SECURAX_HOME_DIR:-$HOME/.securax}/sprout"
    [ -d "$SPD" ] && tar czf "$STG/sprout-secrets.tgz" -C "$(dirname "$SPD")" sprout && echo "sprout-secrets" >> "$STG/MANIFEST" || true
    ( cd "$STG" && sha256sum ./* > SHA256SUMS 2>/dev/null || true )
    tar czf "$PLAIN" -C "$STG" . && tar tzf "$PLAIN" >/dev/null || { C "Backup failed verification."; rm -f "$OUTF"; exit 1; }
    if [ "$ENCRYPT" = 1 ]; then
      OUTF="$OUTF.gpg"
      ( umask 077; gpg_run $GPGSYM --passphrase-file "$BKEY" --symmetric -o "$OUTF" "$PLAIN" ) >/dev/null 2>&1 \
        && gpg_run $GPGSYM --passphrase-file "$BKEY" -d "$OUTF" 2>/dev/null | tar tzf - >/dev/null \
        || { C "Encrypting the backup failed verification — nothing was kept."; rm -f "$OUTF"; exit 1; }
    fi
    chmod 600 "$OUTF" 2>/dev/null || true
    { ls -1t "$DEST"/securax-*.tar.gz "$DEST"/securax-*.tar.gz.gpg 2>/dev/null || true; } | tail -n +$(( $(ev BACKUP_KEEP 7) + 1 )) | xargs -r rm -f   # (|| true: a glob with no match makes ls fail, and pipefail would end the script before the success line)
