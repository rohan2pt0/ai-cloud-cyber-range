      SPH="${SECURAX_HOME_DIR:-$HOME/.securax}"; mkdir -p "$SPH" && chmod 700 "$SPH" && tar xzf "$STG/sprout-secrets.tgz" -C "$SPH" && echo "  ✔ restored sprout secrets"
    fi
