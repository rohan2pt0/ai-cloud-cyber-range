#!/usr/bin/env bash
# SecuRAX — one command to run and operate the whole estate.
#   ./securax up       start the live estate (gateway + models + chat + automation)
#   ./securax status   health + what's running + URLs
#   ./securax demo     run the red-team scorecard + posture scan (no cloud needed)
#   ./securax mcp       run the MCP server (usually launched by your AI client instead)
#   ./securax down     stop everything (free RAM)
# Default (no arg) = up + status.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
C(){ printf '\033[1;36m%s\033[0m\n' "$*"; }

cmd="${1:-up-status}"
case "$cmd" in
  up|up-status)
    C "Starting the live estate (compose profile: ai)…"
    ( cd "$ROOT/local/compose" && { [ -f .env ] || cp .env.example .env; } && docker compose --profile ai up -d --build )
    C "Pulling the local model (one-time)…"
    CID="$(cd "$ROOT/local/compose" && docker compose ps -q ollama 2>/dev/null || true)"
    [ -n "${CID:-}" ] && docker exec "$CID" ollama pull "${LOCAL_MODEL:-qwen2.5:1.5b}" || true
    [ "$cmd" = "up-status" ] && "$0" status || true
    ;;
  status)
    C "SecuRAX — open this first:"
    echo "  ⭐ Guiding Map (your home screen)    : http://localhost:8088"
    echo ""
    C "Everything else:"
    cat <<URLS
  Unified chat (local+cloud, guarded)  : http://localhost:3000
  Private document chat (Red-tier)     : http://localhost:3001
  Automation (n8n + data-tier router)  : http://localhost:5678
  Guardrail gateway API                : http://localhost:8080/healthz
  Visual tour                          : http://localhost:8088/portal/explainer.html
  MCP (let an AI operate it)           : see mcp/README.md
URLS
    curl -fsS http://localhost:8080/healthz >/dev/null 2>&1 && C "gateway: healthy" || echo "  gateway: starting (give it a few seconds)"
    ;;
  open)
    URL="http://localhost:8088"
    ( command -v xdg-open >/dev/null && xdg-open "$URL" ) || ( command -v open >/dev/null && open "$URL" ) ||       ( command -v cmd.exe >/dev/null && cmd.exe /c start "$URL" ) || C "Open $URL in your browser."
    ;;
  doctor)
    C "SecuRAX doctor — resource & health check (global thresholds)"
    DISK=$(df -P . | awk 'NR==2{print $5}' | tr -d '%'); echo "  disk used: ${DISK}%  $([ "${DISK:-0}" -ge 85 ] && echo '⚠ >85% — free space' || echo 'ok')"
    if command -v free >/dev/null; then MEM=$(free | awk '/Mem:/{printf "%d",$3/$2*100}'); echo "  RAM used:  ${MEM}%  $([ "${MEM:-0}" -ge 90 ] && echo '⚠ >90% — close apps / use local-fast model' || echo 'ok')"; fi
    curl -fsS http://localhost:8080/healthz >/dev/null 2>&1 && echo "  gateway:   healthy" || echo "  gateway:   down (run ./securax up)"
    curl -fsS http://localhost:8088 >/dev/null 2>&1 && echo "  guiding map: up" || echo "  guiding map: down"
    ;;
  demo)
    C "Adversarial-ML scorecard:"; python3 "$ROOT/redteam/run_attacks.py" --out "$ROOT/redteam/results.json" | tail -8
    C "AI-security posture:"; python3 "$ROOT/redteam/aispm_scan.py" --root "$ROOT" | python3 -c "import json,sys;d=json.load(sys.stdin);print(' posture',d['posture_score'],d['controls_passed'],'/',d['controls_total'])"
    ;;
  full)
    sub="${2:-up}"
    ( cd "$ROOT/local/compose" && { [ -f .env ] || cp .env.example .env; }
      if [ "$sub" = "down" ]; then docker compose -f docker-compose.yml -f full-stack.yml --profile full down; C "full-scale services stopped.";
      else docker compose -f docker-compose.yml -f full-stack.yml --profile full up -d; C "Mattermost (ChatOps): http://localhost:8065  —  heavy SOC: see docs/securax/10-FULL-STACK.md"; fi )
    ;;
  mcp)   exec python3 "$ROOT/mcp/securax_mcp.py" ;;
  down)  ( cd "$ROOT/local/compose" && docker compose --profile ai down ) ; C "stopped." ;;
  *) echo "usage: ./securax [up|status|demo|open|doctor|mcp|full up|full down|down]"; exit 1 ;;
esac
