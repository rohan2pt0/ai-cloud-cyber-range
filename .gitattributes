# Keep everything LF on every OS (a CRLF checkout breaks bash scripts, .env copies and nginx configs under WSL),
# except Windows batch files, which need CRLF.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
*.woff2 binary

# Vendored OCR engine (tesseract.js) assets — binary, never line-ending-normalised
*.wasm binary
*.traineddata binary
*.traineddata.gz binary
