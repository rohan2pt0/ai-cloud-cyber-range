 ],
 "periodic": [
  {
   "id": "quarterly",
   "label": "Quarterly report of cyber-attacks, threats, incidents and breaches, and mitigation",
   "frequency": "quarterly",
   "due_days_after_period_end": 15,
   "channel": "SEBI (as specified)",
   "notes": "Within 15 days of the quarter ended June, September, December and March."
  }
 ],
