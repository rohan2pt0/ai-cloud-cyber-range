  "paragraphs": "RS.CO"
 },
 "obligations": [
  {
   "id": "sebi-6h",
   "label": "Notify SEBI of an incident falling under CERT-In's directions",
   "from": "detection",
   "within_hours": 6,
   "channel": "E-mail mkt_incidents@sebi.gov.in",
   "fields": [
    {
     "key": "entity_name",
     "label": "Name of the regulated entity"
    },
    {
     "key": "incident_id",
     "label": "Internal incident reference",
     "from": "id"
    },
    {
     "key": "detected_at",
     "label": "Date and time of detection",
     "from": "detected_at"
    },
    {
     "key": "title",
     "label": "Incident summary",
     "from": "title"
    },
    {
     "key": "incident_type",
     "label": "Type of incident (e.g. ransomware, data breach, DDoS, unauthorised access)"
    },
    {
     "key": "systems_affected",
     "label": "Systems / services affected"
    },
    {
     "key": "impact",
     "label": "Business and customer impact"
    },
    {
     "key": "data_affected",
     "label": "Data affected (categories, approximate volume)"
    },
    {
     "key": "actions_taken",
     "label": "Containment and recovery actions so far"
    },
    {
     "key": "contact",
     "label": "Contact person (name, phone, e-mail)"
    }
   ],
   "notes": "Within 6 hours of noticing, detecting, or being brought to notice. Annexure-O SOP applies."
  },
  {
