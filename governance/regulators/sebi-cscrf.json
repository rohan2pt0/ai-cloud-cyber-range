{
 "id": "sebi-cscrf",
 "name": "SEBI — Cybersecurity and Cyber Resilience Framework (CSCRF)",
 "jurisdiction": "IN",
 "applies_to": "SEBI-regulated entities (MIIs, Qualified, Mid-size, Small-size, Self-certification REs).",
 "verified": true,
 "verified_on": "2026-10-14",
