{
  "name": "SecuRAX · Morning Security Brief (6 AM)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [ { "triggerAtHour": 6, "triggerAtMinute": 0 } ] }
      },
      "id": "cron-6am",
      "name": "Every day 6 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "// Compose the brief prompt. Swap this for an RSS Read node (CERT-In, NCIIPC,\n// The Hacker News) when you want live feeds; the summariser stays the same.\nconst prompt = `You are a BFSI security analyst in India. In 5 bullets, summarise today\\'s most relevant cyber and AI-security developments for an Indian bank CISO. Add one \\\"action for today\\\". Keep it under 150 words.`;\nreturn [{ json: { prompt } }];"
      },
      "id": "compose",
      "name": "Compose brief prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://gateway:8080/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "Authorization", "value": "Bearer sk-range-dev" }, { "name": "Content-Type", "value": "application/json" } ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'bank-assistant', messages: [{ role: 'user', content: $json.prompt }] }) }}",
        "options": {}
      },
      "id": "summarise",
      "name": "Summarise (via gateway)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "jsCode": "// The brief is ready in $json. Wire your delivery here:\n//  - Gmail / Microsoft Outlook node to email it, or\n//  - Obsidian/Markdown file write, or\n//  - Todoist node to create action items.\nconst brief = $json.choices ? $json.choices[0].message.content : JSON.stringify($json);\nreturn [{ json: { brief } }];"
      },
      "id": "deliver",
      "name": "Deliver (wire your channel)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [940, 300]
    }
  ],
  "connections": {
    "Every day 6 AM": { "main": [ [ { "node": "Compose brief prompt", "type": "main", "index": 0 } ] ] },
    "Compose brief prompt": { "main": [ [ { "node": "Summarise (via gateway)", "type": "main", "index": 0 } ] ] },
    "Summarise (via gateway)": { "main": [ [ { "node": "Deliver (wire your channel)", "type": "main", "index": 0 } ] ] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
