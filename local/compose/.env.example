# Copy to .env and fill in. .env is git-ignored. Never commit real keys.
GUARDRAIL_MODE=enforce
FAIL_MODE=closed
UPSTREAM_URL=http://litellm:4000/v1
LITELLM_MASTER_KEY=sk-range-change-me
SYSTEM_PROMPT_CANARY=CANARY-7f3a9c

POSTGRES_PASSWORD=change-me-strong
GRAFANA_PASSWORD=change-me-strong
MM_DB_PASSWORD=change-me-strong

# Sovereign cross-device sync (estate-sync). Device tokens are the ONLY thing
# protecting your life-OS state — make them long & random, one per device:
#   SYNC_TOKENS=$(openssl rand -hex 24),$(openssl rand -hex 24)
# then paste the same token into the Guiding Map (Ops → Cross-device sync).
SYNC_TOKENS=change-me-generate-with-openssl-rand-hex-24
# Where to expose the sync port. Default localhost (safe). To sync your phone,
# set this to THIS host's Tailscale IP, e.g. SYNC_BIND=100.101.102.103
SYNC_BIND=127.0.0.1

# Optional cloud model keys (free tiers). Leave blank to stay fully local.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_API_KEY=
AZURE_API_BASE=
AWS_REGION=ap-south-1

# Point the gateway at local Llama Guard once you `ollama pull llama-guard3:1b`
LLAMA_GUARD_URL=http://ollama:11434
LOCAL_MODEL=qwen2.5:1.5b

# Google Workspace & Microsoft 365 are connected inside n8n (OAuth), NOT here —
# see docs/securax/07-INTEGRATIONS.md. App subscriptions are not API keys.
