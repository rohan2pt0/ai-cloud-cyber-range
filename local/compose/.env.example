# Copy to .env and fill in (or just run `./securax setup`, which writes this for you).
# .env is git-ignored. NEVER commit real keys. Each key MUST be on its own KEY=value line.

# ── The one thing that makes answers fast ─────────────────────────────────────
# A free Google AI Studio key (https://aistudio.google.com/apikey). With it, the
# "Ask" answers are fast (cloud Gemini Flash, free tier). Without it, the estate
# falls back to the local model (slower on a CPU-only laptop, but fully private).
GEMINI_API_KEY=

# ── Access from your other devices (phone / iPad) ─────────────────────────────
# Default 127.0.0.1 = this laptop only. To open the app on your phone/iPad:
#   • on the same Wi-Fi:   BIND_HOST=0.0.0.0   then browse to http://<laptop-LAN-IP>:8088
#   • best (secure, anywhere): install Tailscale and set BIND_HOST=<this host's 100.x Tailscale IP>
BIND_HOST=127.0.0.1

# ── Core security knobs (sane defaults; leave as-is) ──────────────────────────
GUARDRAIL_MODE=enforce
FAIL_MODE=closed
UPSTREAM_URL=http://litellm:4000/v1
LITELLM_MASTER_KEY=sk-range-change-me
SYSTEM_PROMPT_CANARY=CANARY-7f3a9c
LOCAL_MODEL=qwen2.5:1.5b

# Optional model-based detector (Llama Guard). OFF by default so the estate works
# out of the box — the fast deterministic rails already give 100% red-team defence.
# To enable: `ollama pull llama-guard3:1b` first, THEN set the URL below.
LLAMA_GUARD_URL=

POSTGRES_PASSWORD=change-me-strong
GRAFANA_PASSWORD=change-me-strong
MM_DB_PASSWORD=change-me-strong

# ── Cross-device sync (optional; `./securax setup` can generate the token) ─────
# Long random device token(s), one per device:  openssl rand -hex 24
SYNC_TOKENS=
# Where to expose the sync port (same idea as BIND_HOST).
SYNC_BIND=127.0.0.1

# ── AI provider plugins (easiest: `./securax providers add`) ──────────────────
# Add a key here (or via the wizard) and that provider's model appears in Chat,
# still routed through the security gateway. Model IDs change often — override any
# default with <ID>_MODEL (e.g. OPENAI_MODEL=openai/gpt-4o). See
# docs/securax/22-PLUGINS-AND-PROVIDERS.md and plugins/catalog.json.
# Optional thinking cap (fewer reasoning tokens, faster answers): GROQ_REASONING=low, GEMINI_REASONING=minimal,
# ANTHROPIC_REASONING=low. Off unless set; ignored where it would not reduce thinking. See doc 50.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# OpenCode Go (flat $10/month open models: DeepSeek V4.1 Flash, GLM, Kimi...). Used on the BUILD ladder only. Key: https://opencode.ai/go
OPENCODE_GO_API_KEY=
# Cerebras: EVALUATION ONLY ($5 trial credit, 30 days, 5 requests/min). In no chain unless you add it: ./securax providers chain builder add cerebras
CEREBRAS_API_KEY=
# NVIDIA NIM: free, building only (development use is within its terms; never Chat). ./securax providers add nvidia_nim
NVIDIA_NIM_API_KEY=
# Your own build-chain order (optional; local is always kept last):  ./securax providers chain builder show
CHAIN_BUILDER=
MISTRAL_API_KEY=
XAI_API_KEY=              # xAI / Grok
PERPLEXITYAI_API_KEY=     # Perplexity Sonar
OPENROUTER_API_KEY=
# Groq: very fast free tier (daily token caps apply). Another free rung on the ladder.
GROQ_API_KEY=
# Azure AI Foundry / Azure OpenAI: set the endpoint and your DEPLOYMENT name (not the base model).
AZURE_API_KEY=
AZURE_API_BASE=           # https://<resource>.openai.azure.com
# AZURE_MODEL=azure/<your-deployment-name>
# AWS Bedrock (enable model access in the Bedrock console first):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
# BEDROCK_MODEL=bedrock/anthropic.claude-3-5-sonnet-20241022-v2:0

# ── Voice plugin (ElevenLabs text-to-speech) — `./securax say "hello"` ─────────
# NOTE: text sent to `say` goes to ElevenLabs' API (not sovereign).
# ELEVENLABS_VOICE_ID is optional — it picks a specific voice; defaults to a standard one.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── Heavy-compute plugin (recipe, not a key) ──────────────────────────────────
# Lend the estate a stronger machine you own (doc 56): its Ollama over Tailscale, e.g. http://100.x.y.z:11434 or http://pc.tailnet.ts.net:11434
# (only loopback / private LAN / Tailscale addresses are accepted). HOME_MODEL = a model pulled THERE, e.g. ollama/qwen2.5:14b
REMOTE_OLLAMA_BASE=
HOME_MODEL=

# ── Resource tuning — `./securax profile` sets these for YOUR machine ──────────
# (RAM/CPU caps for the local model, and lite mode that skips Private Docs + n8n.)
OLLAMA_MEM=5g
OLLAMA_CPUS=3.0
OLLAMA_KEEP_ALIVE=30m
SECURAX_LITE=

# ── Build SecuRAX with its OWN models (reduce Claude dependency) ───────────────
# BUILD_MODEL=builder is the resilient build ladder (see docs/securax/24-RESILIENCE-AND-LOW-RESOURCE.md).
# See docs/securax/23-BUILD-WITHOUT-CLAUDE.md. Default build model for `./securax build`.
BUILD_MODEL=builder
# Sovereign local coder: set to 1 and `./securax pull qwen2.5-coder:7b` (or :14b/:30b by RAM).
ENABLE_LOCAL_CODER=
# CODER_MODEL=ollama/qwen2.5-coder:14b   # override the local coder by RAM/VRAM

# Google Workspace & Microsoft 365 are connected inside n8n (OAuth), NOT here —
# see docs/securax/07-INTEGRATIONS.md. App subscriptions are not API keys.

# --- Resilience (all optional) ---------------------------------------------------------------------------
# ./securax watch  tells you when the estate goes down / recovers: set this to a webhook URL that accepts a
# plain-text POST (for example your private ntfy.sh topic). Only a short status line is ever sent.
ALERT_WEBHOOK=
# ./securax backup keeps this many newest backups in ./backups
BACKUP_KEEP=7

# ---- Regulated deployments (all optional; the laptop default is open and needs none of this) -------------------------------------------------
# One switch:  ./securax regulated on   (sets the values below for you).  Details: docs/securax/36-IDENTITY-INCIDENT-RESIDENCY.md
# SECURAX_PROFILE: personal | regulated   (regulated: the cockpit treats open sign-in / no residency as red)
SECURAX_PROFILE=personal
# AUTH_MODE: off | optional | required   (gateway sign-in; ./securax gateway-auth enable creates the keys the estate's tools need)
AUTH_MODE=off
# RESIDENCY_MODE: off | monitor | enforce   (which data may be processed where; ./securax residency enable --jurisdiction IN)
RESIDENCY_MODE=off
# RESIDENCY_ACTION: reroute | block
RESIDENCY_ACTION=reroute
# OIDC (any provider: Keycloak, Entra ID, Okta...): OIDC_ISSUER=  OIDC_AUDIENCE=  OIDC_JWKS_URL=  AUTH_ROLE_MAP={"idp-role":"admin"}  AUTH_MFA_ROLES=admin,auditor
# Where backups go (another disk or NAS): SECURAX_BACKUP_DIR=/mnt/backup/securax      How many to keep: BACKUP_KEEP=7

# ---- Chat / the Twin (doc 53) ----
# WEBUI_SECRET_KEY is created by `./securax up` on first start; keep it (changing it signs everyone out of Chat).
WEBUI_SECRET_KEY=
OWUI_JWT_EXPIRES_IN=7d
OWUI_WEB_SEARCH=true
OWUI_WEB_SEARCH_ENGINE=duckduckgo
OPENWEBUI_MEM=1536m
