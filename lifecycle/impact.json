{
 "about": "Blast-radius map. For a change, `./securax impact` lists which components it touches, what they feed (downstream), and which real-product journeys prove they still work \u2014 so one change cannot silently hurt another part. Every tracked file must belong to a component (or be ignored on purpose); `fitness` fails otherwise, so the map cannot rot.",
 "components": {
  "gateway": {
   "paths": [
    "apps/llm-gateway/**"
   ],
   "guarded_by": [
    "gateway_identity",
    "gateway_residency",
    "purple_loop",
    "chat_streaming",
    "fresh_install"
   ],
   "affects": [
    "router",
    "hub-and-pwa",
    "agents",
    "ai-soc",
    "redteam",
    "tenants",
    "governance"
   ]
  },
  "router": {
   "paths": [
    "plugins/**",
    "local/compose/gen_litellm_config.py",
    "local/compose/gen_opencode_config.py",
    "local/compose/litellm-config.yaml",
    "local/compose/model_discovery.py",
    "local/compose/model_bench.py"
   ],
   "guarded_by": [
    "key_wiring_and_failover",
    "provider_opencode_go",
    "model_self_correction",
    "providers_wizard",
    "keys_wizard",
    "local_model_answers"
   ],
   "affects": [
    "gateway"
   ]
  },
  "estate-runtime": {
   "paths": [
    "securax",
    "securax.cmd",
    "install.sh",
    "install.ps1",
    "brand.env",
    "integrations.txt",
    "local/compose/docker-compose.yml",
    "local/compose/full-stack.yml",
    "local/compose/design.yml",
    "local/compose/.env.example",
    "local/compose/evidence.py",
    "local/compose/guiding-map.conf",
    "local/compose/tls.yml",
    "local/compose/tls-move.yml",
    "local/compose/tls-internal.yml",
    "local/compose/tls-sidecars/**",
    "local/compose/tls-edge.generated.conf",
    "local/compose/sprout/**",
    "local/compose/stage-sprout.yml",
    "local/compose/digest-pins.json",
    "tools/digest_check.py",
    "local/compose/tests/**",
    "local/scripts/**",
    "START-HERE*",
    "WINDOWS-QUICKSTART.md",
    "Makefile",
    "STOP-Windows.bat",
    "*.bat",
    ".editorconfig",
    ".pre-commit-config.yaml",
    "local/compose/controls/**"
   ],
   "guarded_by": [
    "fresh_install",
    "machine_alone",
    "self_healing",
    "watchdog_heals_and_alerts",
    "update_from_dirty_checkout",
    "safe_update_rollback",
    "elastic_resources",
    "blockers_are_explained",
    "backup_restore",
    "cockpit_page",
    "tls_edge",
    "tls_internal",
    "backup_encrypted",
    "ransomware_recovery",
    "inspect_sandbox",
    "rollback_anytime"
   ],
   "affects": [
    "gateway",
    "hub-and-pwa",
    "governance"
   ]
  },
  "hub-and-pwa": {
   "paths": [
    "guiding-map/**",
    "portal/**"
   ],
   "guarded_by": [
    "ui_guiding_map_and_hub",
    "guiding_map_full_use",
    "open_webui_chat",
    "cockpit_page",
    "phone_device"
   ],
   "affects": []
  },
  "estate-sync": {
   "paths": [
    "apps/estate-sync/**"
   ],
   "guarded_by": [
    "ui_guiding_map_and_hub",
    "two_nodes",
    "phone_device"
   ],
   "affects": [
    "hub-and-pwa"
   ]
  },
  "agents": {
   "paths": [
    "agents/**",
    "routines/**",
    "mcp/**",
    "design/**",
    "personal-rnd/**",
    "intel/**",
    "integrations/**",
    "assistant/**",
    "finance/**",
    "learning/**",
    "knowledge/**"
   ],
   "guarded_by": [
    "autobuild_loop"
   ],
   "affects": []
  },
  "ai-soc": {
   "paths": [
    "ai-soc/**"
   ],
   "guarded_by": [
    "purple_loop",
    "offline_power"
   ],
   "affects": [
    "governance"
   ]
  },
  "redteam": {
   "paths": [
    "redteam/**",
    "notebooks/**"
   ],
   "guarded_by": [
    "purple_loop"
   ],
   "affects": [
    "governance"
   ]
  },
  "governance": {
   "paths": [
    "governance/**",
    "templates/**",
    "integrations/rea/**",
    "docs/securax/regulatory/**"
   ],
   "guarded_by": [
    "ccsp_evidence",
    "comply_evidence",
    "incident_clock",
    "gateway_identity",
    "gateway_residency",
    "cockpit_page",
    "backup_encrypted",
    "ransomware_recovery",
    "inspect_sandbox",
    "rollback_anytime"
   ],
   "affects": []
  },
  "lifecycle": {
   "paths": [
    "lifecycle/**",
    "tools/mutate.py",
    "tools/mutate.json",
    "tools/mutate-baseline.json",
    "infra/**",
    "gitops/**",
    "policies/**",
    "local/k8s/**",
    "vendor/**",
    "organs/**"
   ],
   "guarded_by": [
    "lifecycle_sprout",
    "lifecycle_burrow",
    "lifecycle_range",
    "lifecycle_cloud_is_safe",
    "lifecycle_organs",
    "gameday",
    "vet_gate",
    "diffcheck_gate",
    "autobench_selftest"
   ],
   "affects": [
    "governance"
   ]
  },
  "tenants": {
   "paths": [
    "gitops/charts/tenant/**",
    "gitops/tenants/**",
    "gitops/metering/**"
   ],
   "guarded_by": [
    "lifecycle_cloud_is_safe"
   ],
   "affects": []
  },
  "engineering": {
   "paths": [
    "sandbox/**",
    "BUILD-CONTRACT.md",
    ".github/**",
    "pyproject.toml",
    "pytest.ini",
    ".gitignore",
    ".gitleaksignore",
    "trivy.yaml",
    ".trivyignore.yaml",
    ".gitattributes",
    "VERSION"
   ],
   "guarded_by": [
    "fresh_install"
   ],
   "affects": [
    "estate-runtime"
   ]
  },
  "exercise": {
   "paths": [
    "exercise/**"
   ],
   "guarded_by": [
    "exercise_lite_range",
    "exercise_portal_ui"
   ],
   "affects": []
  }
 },
 "ignore": [
  "docs/**",
  "mkdocs.yml",
  "website/**",
  "tools/publish-clean.sh",
  "tools/readme_sync.py",
  "tools/linkcheck.py",
  "tools/features_sync.py",
  "tools/windows/**",
  "features.json",
  "*.md",
  "LICENSE*",
  "CODEOWNERS",
  ".github/ISSUE_TEMPLATE/**",
  "*.png",
  "*.svg",
  "*.jpg"
 ],
 "blind_spots_note": "A component with no guarding journey is a blind spot: changes there are checked only by unit tests."
}
