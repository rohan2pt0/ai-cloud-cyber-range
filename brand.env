# Your brand and public addresses: the ONE place they live (like requirements.txt for identity).
# Change a line here (or set the same name as an environment variable, which wins) and every page, script and build
# picks it up. Nothing else in the code may name these values: `./securax config check` and CI fail if one creeps back.
# All of these are optional "good to have": the estate itself runs with none of them.
BRAND_NAME=CyberBaba
PRODUCT_NAME=SecuRAX
SITE_DOMAIN=cyberbaba.org
CONTACT_EMAIL=hello@cyberbaba.org
# Where the code lives (GitHub owner/repo) and where its images are published.
REPO_SLUG=rohan2pt0/ai-cloud-cyber-range
IMAGE_REGISTRY=ghcr.io/rohan2pt0
